# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never commit a real key.

# Required: your TypeSafe API key.
TYPESAFE_API_KEY=

# Optional app settings (defaults shown).
# Cap on live, billed Jev requests per client per hour.
# LIVE_BUDGET_PER_HOUR=1000
# Where finished games are logged for scripts/evaluate.py.
# GAMES_LOG=logs/games.jsonl
# GoatCounter site code for usage analytics (https://<code>.goatcounter.com). Unset = no analytics.
# GOATCOUNTER_CODE=
# GoatCounter ignores localhost; set to 1 only while testing analytics locally.
# GOATCOUNTER_ALLOW_LOCAL=1

# Optional TypeSafe SDK settings (defaults shown).
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_LOG_LEVEL=
